---
import { profile } from '../data/profile';
const currentPath = Astro.url.pathname;
---
<header class="shell flex items-center justify-between py-6 sm:py-8">
  <a href="/" class="text-sm font-semibold tracking-tight no-underline">{profile.name}<span class="text-accent">.</span></a>
  <nav aria-label="Main navigation" class="flex items-center gap-4 text-sm text-muted sm:gap-6">
    <a class:list={['no-underline hover:text-ink', { 'text-ink': currentPath === '/' }]} href="/#work">Work</a>
    <a class="no-underline hover:text-ink" href="/#about">About</a>
    <a class="no-underline hover:text-ink" href="/#contact">Contact</a>
  </nav>
</header>
