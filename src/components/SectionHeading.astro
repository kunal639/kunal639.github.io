---
interface Props { number: string; title: string; detail?: string }
const { number, title, detail } = Astro.props;
---
<div class="mb-8 flex items-baseline justify-between gap-6 sm:mb-12">
  <div class="flex items-baseline gap-3"><span class="eyebrow text-accent">{number}</span><h2 class="text-xl font-semibold tracking-tight sm:text-2xl">{title}</h2></div>
  {detail && <p class="hidden max-w-sm text-right text-sm text-muted sm:block">{detail}</p>}
</div>
