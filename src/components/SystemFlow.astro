---
interface Props { steps: { label: string; detail: string }[]; compact?: boolean }
const { steps, compact = false } = Astro.props;
---
<ol class:list={['system-flow', { 'system-flow--compact': compact }]} aria-label="System flow">
  {steps.map((step, index) => <li class="system-flow__step"><span class="system-flow__index">0{index + 1}</span><div><p class="system-flow__label">{step.label}</p><p class="system-flow__detail">{step.detail}</p></div></li>)}
</ol>
